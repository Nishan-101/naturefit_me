# ---------------------------------------------
# Server
# ---------------------------------------------
PORT=5000
NODE_ENV=production

# Comma-separated list of allowed origins for CORS (your Vercel frontend URL(s))
CLIENT_ORIGIN=https://naturefit.site,https://www.naturefit.site,http://localhost:5000

# ---------------------------------------------
# MySQL Database (Clever Cloud)
# ---------------------------------------------
DB_HOST=your-clevercloud-host.mysql-instances.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSL=false

# ---------------------------------------------
# Email (Resend). The API uses RESEND_API_KEY. SMTP values are unused by the current mailer.
# ---------------------------------------------
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASSWORD=your_smtp_app_password

# Address that receives the contact form notifications
ADMIN_EMAIL=naturefitdxb@gmail.com
# Every meal-plan inquiry is emailed here. Reply in Gmail reaches the customer.
INQUIRY_EMAIL=naturefitdxb@gmail.com
# "From" address used when sending emails (often must match SMTP_USER)
MAIL_FROM="Nature Fit Restaurant <inquiries@naturefit.site>"

# ---------------------------------------------
# Rate limiting
# ---------------------------------------------
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
CONTACT_RATE_LIMIT_MAX=5

# ---------------------------------------------
# Staff sessions
# A random string of at least 24 characters. Keep this secret.
# ---------------------------------------------
SESSION_SECRET=replace-with-a-long-random-string

# ---------------------------------------------
# Staff dashboard
# At least 10 characters. This is the only staff password.
# ---------------------------------------------
ADMIN_PASSWORD=replace-with-a-long-staff-password
