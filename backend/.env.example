# ---------------------------------------------
# Server
# ---------------------------------------------
PORT=5000
NODE_ENV=production

# Comma-separated list of allowed origins for CORS (your Vercel frontend URL(s))
CLIENT_ORIGIN=https://naturefitrestaurant.vercel.app,http://localhost:5500

# ---------------------------------------------
# MySQL Database (Clever Cloud)
# ---------------------------------------------
DB_HOST=your-clevercloud-host.mysql-instances.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSL=false

# ---------------------------------------------
# Nodemailer (SMTP) — e.g. Gmail, SendGrid, Mailgun, etc.
# ---------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASSWORD=your_smtp_app_password

# Address that receives the contact form notifications
ADMIN_EMAIL=admin@naturefitrestaurant.com
# "From" address used when sending emails (often must match SMTP_USER)
MAIL_FROM="Nature Fit Restaurant Website" <no-reply@naturefitrestaurant.com>

# ---------------------------------------------
# Rate limiting
# ---------------------------------------------
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
CONTACT_RATE_LIMIT_MAX=5
