# ---------------------------------------------
# Server
# ---------------------------------------------
PORT=5000
NODE_ENV=production

# Comma-separated list of allowed origins for CORS (your Vercel frontend URL(s))
CLIENT_ORIGIN=https://naturefit.site,https://www.naturefit.site,http://localhost:5000

# ---------------------------------------------
# MySQL Database (Clever Cloud)
# ---------------------------------------------
DB_HOST=your-clevercloud-host.mysql-instances.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSL=false

# ---------------------------------------------
# Email (Resend). The API uses RESEND_API_KEY. SMTP values are unused by the current mailer.
# ---------------------------------------------
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASSWORD=your_smtp_app_password

# Address that receives the contact form notifications
ADMIN_EMAIL=naturefitdxb@gmail.com
# Every meal-plan inquiry is emailed here. Reply in Gmail reaches the customer.
INQUIRY_EMAIL=naturefitdxb@gmail.com
# "From" address used when sending emails (often must match SMTP_USER)
MAIL_FROM="Nature Fit Restaurant <inquiries@naturefit.site>"

# ---------------------------------------------
# Rate limiting
# ---------------------------------------------
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
CONTACT_RATE_LIMIT_MAX=5

# ---------------------------------------------
# Staff sessions
# A random string of at least 24 characters. Keep this secret.
# ---------------------------------------------
SESSION_SECRET=replace-with-a-long-random-string

# At least 10 characters. This is the staff dashboard password.
ADMIN_PASSWORD=replace-with-a-long-staff-password

# Public site URL used for Stripe return pages.
# The live service must stay on https://naturefit.site.
# A staging service needs its own URL, and that URL must not contain naturefit.site.
PUBLIC_SITE_URL=https://naturefit.site

# Live Render service: APP_ENV=production.
# OTP is skipped only on a separate staging service when every condition below is true:
# APP_ENV=staging, STAGING_OTP_OPTIONAL=true, STRIPE_SECRET_KEY=sk_test_...,
# STRIPE_LIVE_ENABLED is unset, PUBLIC_SITE_URL plus CLIENT_ORIGIN do not contain naturefit.site,
# and the connection matches the staging database identity below.
# The Clever Cloud add-on name naturefit_staging is not the MySQL database name.
# Copy the staging add-on's real host, database name, user, and password into DB_HOST, DB_NAME,
# DB_USER, and DB_PASSWORD, and repeat the host, database name, and user in STAGING_DB_*.
# PRODUCTION_DB_HOST, PRODUCTION_DB_NAME, and PRODUCTION_DB_USER are a denylist only.
# Do not put the production password in this service, and do not put any of these values in git.
APP_ENV=production
STAGING_OTP_OPTIONAL=
STAGING_DB_ADDON=
STAGING_DB_HOST=
STAGING_DB_NAME=
STAGING_DB_USER=
PRODUCTION_DB_HOST=
PRODUCTION_DB_NAME=
PRODUCTION_DB_USER=

# ---------------------------------------------
# Payments (Stripe). Leave blank until the restaurant is ready to take cards.
# Start in test mode: STRIPE_SECRET_KEY=sk_test_... and leave STRIPE_LIVE_ENABLED unset.
# Never put the secret key in frontend code.
# Webhook endpoint:
# https://naturefit-me.onrender.com/api/payments/stripe/webhook
# Events: checkout.session.completed, checkout.session.expired, payment_intent.payment_failed
# Live payments need a live sk_live_ key, the live webhook secret, and STRIPE_LIVE_ENABLED=true.
# Amounts are sent to Stripe in AED fils (2 decimal places).
# ---------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_ENABLED=

# ---------------------------------------------
# SMS OTP (Twilio Verify). Leave blank until the restaurant can send real SMS.
# Create a Verify service at https://console.twilio.com/us1/develop/verify/services
# Use a 6-digit code and a 10-minute expiry. No code is sent while these are blank.
# ---------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---------------------------------------------
# WhatsApp
# Click-to-chat uses the number saved in the staff dashboard.
# Cloud API customer templates also need the three values below.
# Suggested template variables, in order:
# name, order number, plan, meals per day, duration, start date, total, payment status
# ---------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_BUSINESS_NUMBER=971502483083
